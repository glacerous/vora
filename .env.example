# Cloudflare Credentials and Configurations

# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare R2 Credentials & Bucket Name
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

# Optional: Cloudflare R2 Custom Domain or Public URL Prefix (e.g., https://pub-xxx.r2.dev)
R2_PUBLIC_URL_PREFIX=

# Cloudflare D1 Database Configuration
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id_here

# Cloudflare API Token (with D1:Edit permissions)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
